<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(MSBuildProjectName)'=='KuboPlayer'">
    <TargetName>PlayerRuntimeChecks</TargetName>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)'=='KuboPlayer'">
    <ClCompile Remove="main.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)player_runtime_checks.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)player_lighting_fixture.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)player_sprite_fixture.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)player_particle_fixture.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)animator_host_fixture.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)runtime_prefab_host_fixture.cpp" />
  </ItemGroup>
</Project>
