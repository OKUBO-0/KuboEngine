<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <KuboSdkRoot Condition="'$(KuboSdkRoot)'==''">$(MSBuildThisFileDirectory)</KuboSdkRoot>
  </PropertyGroup>
  <Import Project="$(KuboSdkRoot)KuboRuntime.Includes.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>KUBO_RUNTIME_ONLY;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(KuboSdkRoot)lib\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>KuboRuntime.lib;DirectXTex.lib;KuboLua.lib;assimp.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'=='Release'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <AdditionalOptions>/ignore:4049 /ignore:4098 /ignore:4099 %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <Manifest><AdditionalManifestFiles>$(KuboSdkRoot)KuboEngine.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles></Manifest>
  </ItemDefinitionGroup>
  <Target Name="ValidateKuboRuntimeSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlatformToolset)'!='v143' or '$(VCToolsVersion)'!='$(KuboSdkVCToolsVersion)'" Text="Use the SDK's recorded MSVC v143 tool version ($(KuboSdkVCToolsVersion)); rebuild the SDK to migrate toolchains." />
    <Error Condition="'$(Platform)'!='x64' or ('$(Configuration)'!='Debug' and '$(Configuration)'!='Release')" Text="KuboRuntime SDK supports Debug/Release x64 only." />
    <Error Condition="!Exists('$(KuboSdkRoot)lib\$(Configuration)\KuboRuntime.lib')" Text="Missing SDK archive for this configuration." />
  </Target>
  <Target Name="CopyKuboRuntimeDeployment" AfterTargets="Build" Condition="'$(ConfigurationType)'=='Application'">
    <ItemGroup><KuboDeployment Include="$(KuboSdkRoot)runtime\**\*" /></ItemGroup>
    <Copy SourceFiles="@(KuboDeployment)" DestinationFiles="@(KuboDeployment->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
